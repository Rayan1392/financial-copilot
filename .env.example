# Public deployment addresses.
FRONTEND_PUBLIC_ORIGIN=https://sapioai.ir
FRONTEND_API_BASE_URL=https://api.sapioai.ir
FRONTEND_PORT=8080
API_PORT=5074
IMAGE_TAG=latest
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false

# Infrastructure secrets. Replace every placeholder in the untracked .env file.
POSTGRES_DB=financial_copilot
POSTGRES_USER=financial_copilot
POSTGRES_PASSWORD=<generate-a-strong-password>
RABBITMQ_USER=financial_copilot
RABBITMQ_PASSWORD=<generate-a-strong-password>
JWT_SIGNING_KEY=<generate-a-long-random-signing-key>
OPENAPI_ENABLED=false
OPENAPI_SERVER_URL=

# OpenAI is the default provider. Abravran remains disabled.
AI_PROVIDER_DEFAULT_PROVIDER=OpenAI
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-5.6-luna
ABRAVRAN_ENABLED=false
ABRAVRAN_API_KEY=
ABRAVRAN_MAX_TOKENS=3000
ABRAVRAN_TEMPERATURE=0.7

# Telegram membership is required before AI billing can reserve credits.
TELEGRAM_REQUIRED_CHANNEL_ID=@financial_copilot_channel
TELEGRAM_BOT_TOKEN_ENVIRONMENT_VARIABLE=TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=<telegram-bot-token>

NADPCO_API_USER_NAME=
NADPCO_API_PASSWORD=
NADPCO_SCHEDULED_SYNC_ENABLED=false

# Direct TSETMC SOAP feed. Keep credentials only in the ignored .env file.
TSETMC_WEB_SERVICE_ENABLED=false
TSETMC_WEB_SERVICE_URL=http://service.tsetmc.com/WebService/TsePublicV2.asmx
TSETMC_WEB_SERVICE_USER_NAME=
TSETMC_WEB_SERVICE_PASSWORD=
TSETMC_WEB_SERVICE_TIMEOUT_SECONDS=60
TSETMC_WEB_SERVICE_RETRY_COUNT=3
TSETMC_INTRADAY_FLOW_0=0
TSETMC_INTRADAY_FLOW_1=1
TSETMC_INTRADAY_FLOW_2=2
TSETMC_INTRADAY_FLOW_3=3
TSETMC_INTRADAY_FLOW_4=4
TSETMC_INTRADAY_FLOW_5=5
TSETMC_INSTRUMENT_FLOW_0=5
TSETMC_INSTRUMENT_FLOW_1=6
TSETMC_INSTRUMENT_FLOW_2=7
TSETMC_DAILY_TRADE_FROM_DATE=20260601
TSETMC_DAILY_INDEX_FROM_DATE=20260601

# CyclicalWaves API credentials. Keep real values only in the ignored .env file.
CYCLICAL_WAVES_BASE_ADDRESS=https://back1.cyclicalwaves.com/api/
CYCLICAL_WAVES_USER_NAME=
CYCLICAL_WAVES_PASSWORD=
CYCLICAL_WAVES_TIMEOUT_SECONDS=30
CYCLICAL_WAVES_RETRY_COUNT=2
CYCLICAL_WAVES_CIRCUIT_BREAK_SECONDS=60
CYCLICAL_WAVES_CIRCUIT_FAILURE_THRESHOLD=5
DATA_SYNC_CONSUMER_COUNT=1
RABBITMQ_MANAGEMENT_PORT=15672

# Fund portfolio report discovery. The host folder is mounted read-only into API and Worker.
FUND_PORTFOLIO_PROVIDER_NAME=ConfiguredLocalStorage
FUND_PORTFOLIO_HOST_PATH=/opt/sapio/financial-copilot/data/fund-portfolios
FUND_PORTFOLIO_CONTAINER_PATH=/data/fund-portfolios
FUND_PORTFOLIO_ALLOWED_PREFIX=
FUND_PORTFOLIO_MAXIMUM_ITEMS_PER_PAGE=100

# Monthly sales quality ranking result limits.
MonthlySalesQualityRanking__DefaultLimit=10
MonthlySalesQualityRanking__MaximumLimit=50

CyclicalWavesDataAcquisition__Enabled=true
CyclicalWavesDataAcquisition__Schedule=0 2 * * *
CyclicalWavesDataAcquisition__RequestDelayMilliseconds=1000
CyclicalWavesDataAcquisition__TimeoutSeconds=30
CyclicalWavesDataAcquisition__RetryCount=1

# CyclicalWaves P/S snapshot and history synchronization.
# Set CyclicalWavesPsSync__Enabled=True to enable scheduled P/S data persistence.
CyclicalWavesPsSync__Enabled=False
CyclicalWavesPsSync__SnapshotCadenceMinutes=1440
CyclicalWavesPsSync__HistoryCadenceHours=168
CyclicalWavesPsSync__MaxConcurrency=4
CyclicalWavesPsSync__RequestDelayMilliseconds=0
CyclicalWavesPsSync__MaxCompaniesPerRun=250
CyclicalWavesPsSync__MaxRunDurationMinutes=90
CyclicalWavesPsSync__MaxResponseBytes=5242880
CyclicalWavesPsSync__MaxHistoryPointsPerCompany=10000
CyclicalWavesPsSync__LeaseDurationMinutes=120
CyclicalWavesPsSync__LeaseRenewalMinutes=10
CyclicalWavesPsSync__AllowManualSyncWhenWorkerDisabled=True
CyclicalWavesPsSync__MaximumAbsoluteRatio=1000.0
CyclicalWavesPsSync__CurrentHistoryTolerance=0.0001

# P/S visualization settings. These control display of persisted P/S data; they do not fetch data.
CYCLICAL_WAVES_PS_VISUALIZATION_ENABLED=true
CYCLICAL_WAVES_STANDALONE_GAUGE=true
CYCLICAL_WAVES_INCLUDE_GAUGE_IN_MONTHLY_TREND=false
CYCLICAL_WAVES_INCLUDE_HISTORY=true
CYCLICAL_WAVES_ALLOW_STALE=true
CYCLICAL_WAVES_MAX_SYNC_AGE_HOURS=48
CYCLICAL_WAVES_MAX_LAG_TRADING_DAYS=2
CYCLICAL_WAVES_MAX_HISTORY_POINTS=5000
CYCLICAL_WAVES_PERCENTAGE_DECIMALS=2
