{
  "ConnectionStrings": {
    "FinancialCopilot": "Host=localhost;Port=5432;Database=financial_copilot;Username=financial_copilot"
  },
  "Billing": {
    "PricingPolicyVersion": "v1",
    "ReservationDurationMinutes": 5
  },
  "FinancialDataProvider": {
    "ProviderName": "ConfiguredFinancialProvider",
    "BaseAddress": "https://provider.invalid/",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "CircuitBreakSeconds": 30,
    "CircuitFailureThreshold": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "JwtBearer": {
      "Authority": "",
      "Issuer": "FinancialCopilot",
      "Audience": "FinancialCopilot.Web",
      "SigningKey": "",
      "RequireHttpsMetadata": true
    },
    "ApiKeys": {
      "Clients": []
    }
  },
  "RateLimiting": {
    "AuthenticatedActor": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "AllowedHosts": "*"
}
