<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>eb21474b-6420-4112-9ae7-e55c18b2b5fe</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.4" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinancialCopilot.Application\FinancialCopilot.Application.csproj" />
    <ProjectReference Include="..\FinancialCopilot.Billing\FinancialCopilot.Billing.csproj" />
    <ProjectReference Include="..\FinancialCopilot.Infrastructure\FinancialCopilot.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="appsettings.Development.Local.json" />
    <None Remove="appsettings.Development.Local.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\specs\141-schema-aware-semantic-query-engine\SemanticCatalog\**\*"
             Link="Feature141Catalog\SemanticCatalog\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\specs\141-schema-aware-semantic-query-engine\artifacts\navigation-hierarchy.yaml"
             Link="Feature141Catalog\navigation-hierarchy.yaml"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
