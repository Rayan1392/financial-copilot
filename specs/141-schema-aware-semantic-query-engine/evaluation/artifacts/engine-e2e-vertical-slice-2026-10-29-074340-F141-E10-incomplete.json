    "Sql": "WITH eligible_observations AS (SELECT c.\"Id\" AS \"CompanyId\", c.\"Name\" AS \"CompanyName\", c.\"Ticker\" AS \"CompanySymbol\", li.\"Title\" AS \"ProductTitle\", li.\"ProductCode\" AS \"ProductCode\", li.\"ProductionQuantity\" AS \"Value\", li.\"Unit\" AS \"SourceUnit\", r.\"PeriodStart\" AS \"PeriodStart\", r.\"PeriodEnd\" AS \"PeriodEnd\", r.\"ProviderName\" AS \"ProviderName\", r.\"Id\" AS \"ReportId\", r.\"ExternalReportId\" AS \"ExternalReportId\", li.\"SourceRowFingerprint\" AS \"SourceRowFingerprint\", li.\"SourceMultiplicity\" AS \"SourceMultiplicity\", COUNT(*) OVER (PARTITION BY c.\"Id\", r.\"PeriodEnd\") AS \"SamePeriodCandidateCount\", ROW_NUMBER() OVER (PARTITION BY c.\"Id\" ORDER BY r.\"PeriodEnd\" DESC, r.\"PeriodStart\" DESC, r.\"Id\" ASC, li.\"ProductCode\" ASC) AS \"DiscoveryRank\" FROM \"public\".\"MonthlyReportLineItems\" li JOIN \"public\".\"MonthlyReports\" r ON li.\"MonthlyReportId\" = r.\"Id\" JOIN \"public\".\"Companies\" c ON r.\"CompanyId\" = c.\"Id\" WHERE c.\"Id\" = ANY(@company_ids) AND r.\"ProviderName\" = @provider_name AND r.\"ReportType\" = @report_type AND r.\"OutputType\" = @output_type AND r.\"IsAccepted\" = @is_accepted AND r.\"RevisionStatus\" = @revision_status AND r.\"PeriodStart\" = @period_start AND r.\"PeriodEnd\" = @period_end AND li.\"ProductionQuantity\" > 0 AND BTRIM(li.\"Title\") = ANY(@product_aliases)) SELECT *, 'partial' AS \"ProductMappingCoverageStatus\", @company_coverage_complete AS \"CompanyCoverageComplete\" FROM eligible_observations WHERE \"DiscoveryRank\" = 1 ORDER BY \"CompanyName\" ASC, \"CompanyId\" ASC LIMIT @row_limit",
