    "Sql": "WITH eligible_monthly_rows AS (SELECT r.\"CompanyId\" AS \"CompanyId\", r.\"PeriodStart\" AS \"PeriodStart\", r.\"PeriodEnd\" AS \"PeriodEnd\", li.\"ProductCode\" AS \"ProductCode\", li.\"Title\" AS \"ProductTitle\", li.\"ProductionQuantity\" AS \"Value\", li.\"Unit\" AS \"SourceUnit\", COUNT(*) OVER (PARTITION BY r.\"CompanyId\", r.\"PeriodEnd\", li.\"ProductCode\") AS \"SamePeriodCandidateCount\", r.\"ProviderName\" AS \"ProviderName\", r.\"ReportType\" AS \"ReportType\", r.\"OutputType\" AS \"OutputType\", r.\"RevisionStatus\" AS \"RevisionStatus\", r.\"Id\" AS \"ReportIdentity\", r.\"ExternalReportId\" AS \"ExternalReportId\", li.\"SourceRowFingerprint\" AS \"SourceRowFingerprint\", li.\"SourceMultiplicity\" AS \"SourceMultiplicity\" FROM \"public\".\"MonthlyReportLineItems\" li JOIN \"public\".\"MonthlyReports\" r ON li.\"MonthlyReportId\" = r.\"Id\" WHERE r.\"CompanyId\" = @company_id AND r.\"ProviderName\" = @provider_name AND r.\"ReportType\" = @report_type AND r.\"OutputType\" = @output_type AND r.\"IsAccepted\" = @is_accepted AND r.\"RevisionStatus\" = @revision_status AND li.\"ProductCode\" = @product_code AND r.\"PeriodStart\" >= @period_start AND r.\"PeriodEnd\" <= @period_end),\nprojected_monthly_rows AS (SELECT * FROM eligible_monthly_rows)\nSELECT *, \"ReportIdentity\" AS \"ReportId\" FROM projected_monthly_rows ORDER BY \"CompanyId\", \"PeriodEnd\" ASC, \"ProductCode\", \"SourceMultiplicity\" LIMIT @row_limit OFFSET @row_offset",
