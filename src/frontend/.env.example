# Browser-visible API origin used by the local React application.
VITE_FINANCIAL_COPILOT_API_BASE_URL="http://localhost:5074"

# Optional server-only override for TanStack server functions.
FINANCIAL_COPILOT_API_BASE_URL="http://localhost:5074"

# Optional. Absolute URL of the TahlilApp page for the "بازگشت به تحلیل‌اپ" button on /launch-failed.
# Must be https (http is accepted only for localhost in development) and must not contain credentials.
# Leave empty to hide the button.
VITE_TAHLILAPP_RETURN_URL=""

# Feature 153: automatically redirect phones from /chat, /c/<id> and /followed-symbols to the mobile workspace /m.
# Build-time. Keep "false" in production until the frontend/API origins and refresh-cookie behavior are verified
# (spec D-Q5). /m itself works either way, and users can always switch manually.
VITE_MOBILE_AUTO_REDIRECT="false"
