    "Sql": "WITH latest_period AS (\n  SELECT MAX(st_scope.\"PeriodEnd\") AS \"PeriodEnd\"\n  FROM \"public\".\"FinancialStatements\" st_scope\n  WHERE st_scope.\"CompanyId\" = @company_id\n    AND st_scope.\"ProviderName\" = @provider_name\n    AND st_scope.\"StatementType\" = @statement_type\n  GROUP BY st_scope.\"IsComposing\"\n)\nSELECT li.\"Value\" AS \"Value\", st.\"PeriodEnd\" AS \"PeriodEnd\", st.\"Id\" AS \"StatementId\", st.\"ProviderName\" AS \"ProviderName\", st.\"StatementType\" AS \"StatementType\", @source_item_id AS \"SourceItemId\", (SELECT si.\"Unit\" FROM \"public\".\"FinancialStatementSourceItems\" si WHERE si.\"Id\" = @source_item_catalog_id) AS \"SourceUnit\", @source_item_catalog_id AS \"SourceItemCatalogId\", st.\"IsComposing\" AS \"IsComposing\", st.\"CompanyId\" AS \"CompanyId\", st.\"PeriodType\" AS \"PeriodType\", st.\"IsAudited\" AS \"IsAudited\", st.\"IsRepresented\" AS \"IsRepresented\", st.\"ExternalStatementId\" AS \"ExternalStatementId\", st.\"PeriodStart\" AS \"PeriodStart\", st.\"SourcePayloadChecksum\" AS \"SourcePayloadChecksum\", st.\"PublishedAt\" AS \"PublishedAt\", st.\"LastSynchronizedAt\" AS \"LastSynchronizedAt\", st.\"WarningsJson\" AS \"WarningsJson\", st.\"LogicalVendor\" AS \"LogicalVendor\", st.\"SourceMode\" AS \"SourceMode\"\nFROM \"public\".\"FinancialStatements\" st\nJOIN \"public\".\"Companies\" co ON st.\"CompanyId\" = co.\"Id\"\nLEFT JOIN \"public\".\"FinancialStatementLineItems\" li ON li.\"FinancialStatementId\" = st.\"Id\" AND li.\"SourceItemCatalogId\" = @source_item_catalog_id\nWHERE co.\"Id\" = @company_id\n  AND st.\"ProviderName\" = @provider_name\n  AND st.\"StatementType\" = @statement_type\n  AND EXISTS (SELECT 1 FROM \"public\".\"FinancialStatementSourceItems\" si WHERE si.\"Id\" = @source_item_catalog_id AND si.\"ProviderName\" = @provider_name AND si.\"StatementType\" = @statement_type AND si.\"SourceItemId\" = @source_item_id)\n  AND st.\"PeriodEnd\" IN (SELECT \"PeriodEnd\" FROM latest_period)\nORDER BY st.\"PeriodEnd\" DESC, st.\"PeriodType\", st.\"Id\"\nLIMIT @row_limit OFFSET @row_offset",
