{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": { "Default": "Information" },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "Database": { "ApplyMigrationsOnStartup": true },
  "DataSyncMessaging": {
    "Enabled": true,
    "RequestQueue": "financialcopilot.data-sync.requests"
  },
  "FeatureMessaging": {
    "Enabled": true,
    "RequestedQueue": "financialcopilot.features.recalculate.requested",
    "CompletedQueue": "financialcopilot.features.recalculate.completed",
    "FailedQueue": "financialcopilot.features.recalculate.failed"
  },
  "ScannerCache": {
    "Enabled": true,
    "UseRedis": true,
    "InstanceName": "financial-copilot:",
    "PlanTtlSeconds": 300,
    "ResultTtlSeconds": 60
  },
  "AiModelProviders": {
    "Providers": [
      {
        "ProviderKey": "OpenAI",
        "ModelKey": "gpt-5.6-luna",
        "HostingMode": "Hosted",
        "Adapter": "OpenAI",
        "Endpoint": "https://api.openai.com/v1/",
        "CredentialSecretReference": "OPENAI_API_KEY",
        "Enabled": true,
        "Priority": 10,
        "TimeoutSeconds": 120,
        "Capabilities": "ChatCompletion,StructuredOutput,ToolCalling,Streaming,UsageReporting"
      },
      {
        "ProviderKey": "Abravran",
        "ModelKey": "Gemini-2-5-Flash-91n2v",
        "HostingMode": "Hosted",
        "Adapter": "Abravran",
        "Endpoint": "https://arvancloudai.ir/",
        "CredentialSecretReference": "ABRAVRAN_API_KEY",
        "Enabled": false,
        "Priority": 20,
        "TimeoutSeconds": 120,
        "Capabilities": "ChatCompletion,StructuredOutput,ToolCalling,Streaming,UsageReporting"
      }
    ]
  },
  "AiProvider": {
    "DefaultProvider": "OpenAI",
    "OpenAI": { "Model": "gpt-5.6-luna" },
    "Abravran": {
      "MaxTokens": 3000,
      "Temperature": 0.7
    }
  },
  "Authentication": {
    "JwtBearer": {
      "Issuer": "FinancialCopilot",
      "Audience": "FinancialCopilot.Web",
      "RequireHttpsMetadata": true
    },
    "OwnedIdentity": {
      "DefaultTenantId": "11111111-1111-1111-1111-111111111111",
      "DefaultTenantName": "FinancialCopilot",
      "AccessTokenMinutes": 10080,
      "RefreshTokenDays": 30
    }
  },
  "AiOrchestration": {
    "Mode": "MicrosoftAgentFrameworkV2",
    "WorkflowVersion": "maf-orchestration-v2.0",
    "AgentTimeoutSeconds": 60
  }
}
