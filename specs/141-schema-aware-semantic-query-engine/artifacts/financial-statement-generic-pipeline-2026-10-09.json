  "sqlExecuted": "WITH latest_period AS (\n  SELECT MAX(st_scope.\u0022PeriodEnd\u0022) AS \u0022PeriodEnd\u0022\n  FROM \u0022public\u0022.\u0022FinancialStatements\u0022 st_scope\n  WHERE st_scope.\u0022CompanyId\u0022 = @company_id\n    AND st_scope.\u0022ProviderName\u0022 = @provider_name\n    AND st_scope.\u0022StatementType\u0022 = @statement_type AND st_scope.\u0022IsComposing\u0022 = @is_composing\n  GROUP BY st_scope.\u0022IsComposing\u0022\n)\nSELECT li.\u0022Value\u0022 AS \u0022Value\u0022, st.\u0022PeriodEnd\u0022 AS \u0022PeriodEnd\u0022, st.\u0022Id\u0022 AS \u0022StatementId\u0022, st.\u0022ProviderName\u0022 AS \u0022ProviderName\u0022, st.\u0022StatementType\u0022 AS \u0022StatementType\u0022, @source_item_id AS \u0022SourceItemId\u0022, (SELECT si.\u0022Unit\u0022 FROM \u0022public\u0022.\u0022FinancialStatementSourceItems\u0022 si WHERE si.\u0022Id\u0022 = @source_item_catalog_id) AS \u0022SourceUnit\u0022, @source_item_catalog_id AS \u0022SourceItemCatalogId\u0022, st.\u0022IsComposing\u0022 AS \u0022IsComposing\u0022, st.\u0022CompanyId\u0022 AS \u0022CompanyId\u0022, st.\u0022PeriodType\u0022 AS \u0022PeriodType\u0022, st.\u0022IsAudited\u0022 AS \u0022IsAudited\u0022, st.\u0022IsRepresented\u0022 AS \u0022IsRepresented\u0022, st.\u0022ExternalStatementId\u0022 AS \u0022ExternalStatementId\u0022, st.\u0022PeriodStart\u0022 AS \u0022PeriodStart\u0022, st.\u0022SourcePayloadChecksum\u0022 AS \u0022SourcePayloadChecksum\u0022, st.\u0022PublishedAt\u0022 AS \u0022PublishedAt\u0022, st.\u0022LastSynchronizedAt\u0022 AS \u0022LastSynchronizedAt\u0022, st.\u0022WarningsJson\u0022 AS \u0022WarningsJson\u0022, st.\u0022LogicalVendor\u0022 AS \u0022LogicalVendor\u0022, st.\u0022SourceMode\u0022 AS \u0022SourceMode\u0022\nFROM \u0022public\u0022.\u0022FinancialStatements\u0022 st\nJOIN \u0022public\u0022.\u0022Companies\u0022 co ON st.\u0022CompanyId\u0022 = co.\u0022Id\u0022\nLEFT JOIN \u0022public\u0022.\u0022FinancialStatementLineItems\u0022 li ON li.\u0022FinancialStatementId\u0022 = st.\u0022Id\u0022 AND li.\u0022SourceItemCatalogId\u0022 = @source_item_catalog_id\nWHERE co.\u0022Id\u0022 = @company_id\n  AND st.\u0022ProviderName\u0022 = @provider_name\n  AND st.\u0022StatementType\u0022 = @statement_type\n  AND EXISTS (SELECT 1 FROM \u0022public\u0022.\u0022FinancialStatementSourceItems\u0022 si WHERE si.\u0022Id\u0022 = @source_item_catalog_id AND si.\u0022ProviderName\u0022 = @provider_name AND si.\u0022StatementType\u0022 = @statement_type AND si.\u0022SourceItemId\u0022 = @source_item_id)\n  AND st.\u0022IsComposing\u0022 = @is_composing\n  AND st.\u0022PeriodEnd\u0022 IN (SELECT \u0022PeriodEnd\u0022 FROM latest_period)\nORDER BY st.\u0022PeriodEnd\u0022 DESC, st.\u0022PeriodType\u0022, st.\u0022Id\u0022\nLIMIT @row_limit OFFSET @row_offset",
