{
  "ScannerCache": {
    "Enabled": true,
    "UseRedis": false,
    "RedisConfiguration": "localhost:6379",
    "InstanceName": "financial-copilot:",
    "PlanTtlSeconds": 300,
    "ResultTtlSeconds": 60
  },
  "ConnectionStrings": {
    "FinancialCopilot": "Host=localhost;Port=5432;Database=financial_copilot;Username=financial_copilot"
  },
  "BillingMaintenance": {
    "IntervalSeconds": 60,
    "BatchSize": 100
  },
  "FinancialDataProvider": {
    "ProviderName": "ConfiguredFinancialProvider",
    "BaseAddress": "https://provider.invalid/",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "CircuitBreakSeconds": 30,
    "CircuitFailureThreshold": 3
  },
  "DataSyncMessaging": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "RequestQueue": "financialcopilot.data-sync.requests"
  },
  "FeatureMessaging": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest",
    "RequestedQueue": "financialcopilot.features.recalculate.requested",
    "CompletedQueue": "financialcopilot.features.recalculate.completed",
    "FailedQueue": "financialcopilot.features.recalculate.failed"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
