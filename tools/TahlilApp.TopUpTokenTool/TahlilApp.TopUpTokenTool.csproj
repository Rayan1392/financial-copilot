<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Intentionally the SAME UserSecretsId as FinancialCopilot.API: the tool signs with the exact
      Billing:TahlilAppTopUps:Authentication keys the API validates, so there is one owner of the
      issuer/audience/signing keys and they cannot drift apart.
    -->
    <UserSecretsId>eb21474b-6420-4112-9ae7-e55c18b2b5fe</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.8.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13" />
  </ItemGroup>
</Project>
