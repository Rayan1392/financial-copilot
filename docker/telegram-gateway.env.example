# Copy to a secret-managed .env file on VPS 2. Never commit the populated file.
TELEGRAM_GATEWAY_IMAGE=financial-copilot-telegram-gateway:2026.08.09-1
# Set true only after all required gateway and primary-API secrets are populated.
TELEGRAM_GATEWAY_ENABLED=false
TELEGRAM_GATEWAY_PORT=5088
TELEGRAM_BOT_TOKEN=
TELEGRAM_PRIMARY_API_KEY=
TELEGRAM_GATEWAY_SERVICE_ID=telegram-gateway-vps2
TELEGRAM_GATEWAY_SERVICE_SECRET=
TELEGRAM_GATEWAY_REQUIRE_HTTPS=true
TELEGRAM_GATEWAY_MAX_CLOCK_SKEW_SECONDS=120
TELEGRAM_GATEWAY_RATE_LIMIT_PERMITS=120
TELEGRAM_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_GATEWAY_RATE_LIMIT_QUEUE=0
TELEGRAM_GATEWAY_POLL_INTERVAL_SECONDS=1
TELEGRAM_GATEWAY_LONG_POLL_TIMEOUT_SECONDS=25
TELEGRAM_GATEWAY_REQUEST_TIMEOUT_SECONDS=40
TELEGRAM_GATEWAY_POLLING_LIMIT=50
TELEGRAM_GATEWAY_DELETE_WEBHOOK_ON_START=true
TELEGRAM_GATEWAY_STATE_HOST_PATH=/var/lib/financial-copilot/telegram-gateway
TELEGRAM_PRIMARY_API_BASE_URL=https://api.sapioai.ir
