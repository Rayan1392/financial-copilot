    "Sql": "WITH candidate AS (\n  SELECT c_co.\"Id\" AS \"CompanyId\", c_st.\"PeriodStart\" AS \"PeriodStart\", c_st.\"PeriodEnd\" AS \"PeriodEnd\", c_st.\"PeriodType\" AS \"PeriodType\", c_st.\"IsComposing\" AS \"IsComposing\"\n  FROM \"public\".\"FinancialStatements\" c_st\n  JOIN \"public\".\"Companies\" c_co ON c_st.\"ExternalCompanyId\" = c_co.\"ExternalCompanyId\" AND c_st.\"ProviderName\" = c_co.\"ProviderName\"\n  WHERE c_co.\"Id\" = ANY(@company_ids)\n    AND c_st.\"ProviderName\" = @provider_name\n    AND c_st.\"StatementType\" = @statement_type\n),\ncompany_coverage AS (\n  SELECT c.\"CompanyId\", MAX(c.\"PeriodEnd\") AS \"CompanyLatestPeriodEnd\", COUNT(DISTINCT c.\"IsComposing\") AS \"CompanyBasisCount\"\n  FROM candidate c\n  GROUP BY c.\"CompanyId\"\n),\ncommon_period AS (\n  SELECT c.\"PeriodStart\", c.\"PeriodEnd\", c.\"PeriodType\"\n  FROM candidate c\n  GROUP BY c.\"PeriodStart\", c.\"PeriodEnd\", c.\"PeriodType\"\n  HAVING COUNT(DISTINCT c.\"CompanyId\") = (SELECT COUNT(*) FROM company_coverage)\n),\ntarget_period AS (\n  SELECT cp.\"PeriodStart\", cp.\"PeriodEnd\", cp.\"PeriodType\"\n  FROM common_period cp\n  WHERE cp.\"PeriodEnd\" = (SELECT MAX(cp_latest.\"PeriodEnd\") FROM common_period cp_latest)\n)\nSELECT cc.\"CompanyId\" AS \"CompanyId\", cc.\"CompanyLatestPeriodEnd\" AS \"CompanyLatestPeriodEnd\", cc.\"CompanyBasisCount\" AS \"CompanyBasisCount\", li.\"Value\" AS \"Value\", st.\"PeriodStart\" AS \"PeriodStart\", st.\"PeriodEnd\" AS \"PeriodEnd\", st.\"PeriodType\" AS \"PeriodType\", st.\"Id\" AS \"StatementId\", st.\"ProviderName\" AS \"ProviderName\", st.\"StatementType\" AS \"StatementType\", @source_item_id AS \"SourceItemId\", (SELECT si.\"Unit\" FROM \"public\".\"FinancialStatementSourceItems\" si WHERE si.\"Id\" = @source_item_catalog_id) AS \"SourceUnit\", @source_item_catalog_id AS \"SourceItemCatalogId\", st.\"IsComposing\" AS \"IsComposing\", st.\"IsAudited\" AS \"IsAudited\", st.\"IsRepresented\" AS \"IsRepresented\", st.\"ExternalStatementId\" AS \"ExternalStatementId\", st.\"SourcePayloadChecksum\" AS \"SourcePayloadChecksum\", st.\"PublishedAt\" AS \"PublishedAt\", st.\"LastSynchronizedAt\" AS \"LastSynchronizedAt\", st.\"WarningsJson\" AS \"WarningsJson\", st.\"LogicalVendor\" AS \"LogicalVendor\", st.\"SourceMode\" AS \"SourceMode\", co.\"Ticker\" AS \"CompanySymbol\", co.\"Name\" AS \"CompanyName\", li.\"Value\" AS \"FilterValue0\", (li.\"Value\" > @filter_threshold_0) AS \"FilterMatched0\", lf0.\"Value\" AS \"FilterValue1\", (lf0.\"Value\" > @filter_threshold_1) AS \"FilterMatched1\"\nFROM company_coverage cc\nJOIN \"public\".\"Companies\" co ON co.\"Id\" = cc.\"CompanyId\"\nLEFT JOIN \"public\".\"FinancialStatements\" st ON st.\"ExternalCompanyId\" = co.\"ExternalCompanyId\" AND st.\"ProviderName\" = co.\"ProviderName\"\n  AND st.\"ProviderName\" = @provider_name AND st.\"StatementType\" = @statement_type\n  AND EXISTS (SELECT 1 FROM target_period tp WHERE tp.\"PeriodStart\" = st.\"PeriodStart\" AND tp.\"PeriodEnd\" = st.\"PeriodEnd\" AND tp.\"PeriodType\" = st.\"PeriodType\")\nLEFT JOIN \"public\".\"FinancialStatementLineItems\" li ON li.\"FinancialStatementId\" = st.\"Id\" AND li.\"SourceItemCatalogId\" = @source_item_catalog_id\nLEFT JOIN \"public\".\"FinancialStatementLineItems\" lf0 ON lf0.\"FinancialStatementId\" = st.\"Id\" AND lf0.\"SourceItemCatalogId\" = @filter_source_item_catalog_id_0\nWHERE co.\"Id\" = ANY(@company_ids)\n  AND EXISTS (SELECT 1 FROM \"public\".\"FinancialStatementSourceItems\" si WHERE si.\"Id\" = @source_item_catalog_id AND si.\"ProviderName\" = @provider_name AND si.\"StatementType\" = @statement_type AND si.\"SourceItemId\" = @source_item_id)\nORDER BY cc.\"CompanyId\", st.\"PeriodType\", st.\"Id\"\nLIMIT @row_limit",
